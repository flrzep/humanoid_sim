<!-- Unitree H1 scene for IMU_Sim: the stock H1 model plus IMU sensors at the
     existing torso "imu" site and a bent-knee standing keyframe for balancing.
     Lives in the H1 directory so mesh/asset paths resolve correctly. -->
<mujoco model="h1_imusim">
  <include file="h1.xml"/>

  <statistic center="0 0 1" extent="1.8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="160" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 3.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
  </worldbody>

  <!-- IMU sensors at the pelvis (floating base) "imu_pelvis" site (added for
       IMU_Sim). Mounting on the base body matches the controller's attitude state
       exactly, just like the classic humanoid. Names match what the loader expects. -->
  <sensor>
    <accelerometer name="imu_accel" site="imu_pelvis"/>
    <gyro name="imu_gyro" site="imu_pelvis"/>
    <framequat name="imu_quat" objtype="site" objname="imu_pelvis"/>
    <framepos name="imu_pos" objtype="site" objname="imu_pelvis"/>
    <velocimeter name="imu_vel" site="imu_pelvis"/>
  </sensor>

  <keyframe>
    <!-- Bent-knee two-legged standing pose (from the stock "home" keyframe);
         height refined by the equilibrium finder in model.py. -->
    <key name="stand"
         qpos="0 0 0.98 1 0 0 0
               0 0 -0.4 0.8 -0.4
               0 0 -0.4 0.8 -0.4
               0
               0 0 0 0
               0 0 0 0"/>
  </keyframe>
</mujoco>
